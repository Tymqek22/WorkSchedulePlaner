@using WorkSchedulePlaner.Web.Requests
@model UpsertAssignmentRequest

<div class="card">
	<div class="card-header text-center">
		<h3 class="card-title">Add Shift Tile</h3>
	</div>
	<div class="card-body">
		<form method="post" class="row">
			<div asp-validation-summary="All" class="text-danger mb-3 font-weight-bold"></div>
			<div class="form-floating mb-2">
				<input class="form-control" id="floatingTitle" asp-for="Title" />
				<label for="floatingTitle" class="ms-2">Title</label>
				<span asp-validation-for="Title" class="text-danger"></span>
			</div>
			<div class="form-floating mb-2">
				<input class="form-control" id="floatingDescription" asp-for="Description" />
				<label for="floatingDescription" class="ms-2">Description</label>
			</div>

			<div id="itemsContainer"></div>

			<button type="button" class="btn btn-primary mb-2" data-bs-toggle="modal" data-bs-target="#employeeModal">
				Add Employee
			</button>

			<input type="hidden" asp-for="Date" value="@Model.Date" />
			<input type="hidden" asp-for="ScheduleId" />

			<div class="d-flex justify-content-center gap-4">
				<button type="submit" class="btn btn-success w-100">
					<i class="bi bi-plus-circle"></i>
					Add Shift
				</button>
				<a class="btn btn-danger w-100" asp-controller="Schedule" asp-action="Details" 
				asp-route-id="@Model.ScheduleId">
					<i class="bi bi-x-circle"></i>
					Cancel
				</a>
			</div>
			
		</form>
	</div>
</div>

<div class="modal fade" id="employeeModal" tabindex="-1" aria-labelledby="employeeModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h1 class="modal-title fs-5" id="employeeModalLabel">Add Employee</h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div class="p-3 border rounded bg-light" id="employeeForm">
					<select class="form-select mb-2" id="selectEmployee" asp-items="@Model.Employees">
						<option>--Select Employee--</option>
					</select>

					<div class="d-flex justify-content-center gap-5">
						<div class="form-floating mb-2">
							<input class="form-control" type="time" id="startTime" />
							<label for="startTime" class="ms-2">Start Time</label>
						</div>
						<div class="form-floating mb-2">
							<input class="form-control" type="time" id="endTime" />
							<label for="endTime" class="ms-2">End Time</label>
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
				<button type="button" class="btn btn-success" id="addEmployee" data-bs-dismiss="modal">Add</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		let index = 0;

		document.getElementById("addEmployee").addEventListener("click", function () {

			const selectElement = document.getElementById("selectEmployee");

			const employeeId = selectElement.value;
			const displayName = selectElement.options[selectElement.selectedIndex].text;
			const startTime = document.getElementById("startTime").value;
			const endTime = document.getElementById("endTime").value;

			if (!employeeId || selectElement.selectedIndex === 0 || !startTime || !endTime) {
				alert("Please select an employee and fill both times.");
				return;
			}

			const container = document.getElementById("itemsContainer");
			const itemId = `item-${index}`;
			const itemHtml = `
					<div id="${itemId}" class="subitem mb-2 d-flex gap-2 align-items-center">
						<input class="form-control" value="${displayName} | ${startTime} - ${endTime}" disabled readonly/>

						<input type="hidden" name="Shifts[${index}].EmployeeId" value="${employeeId}" />
						<input type="hidden" name="Shifts[${index}].StartTime" value="${startTime}" />
						<input type="hidden" name="Shifts[${index}].EndTime" value="${endTime}" />

						<button type="button" class="btn btn-danger remove-btn" onclick="removeItem('${itemId}')">Delete</button>
					</div>
			`;

			container.insertAdjacentHTML("beforeend",itemHtml);
			index++;

			document.getElementById("selectEmployee").selectedIndex = 0;
			document.getElementById("startTime").value = "";
			document.getElementById("endTime").value = "";
		});

		function removeItem(id) {
			const element = document.getElementById(id);

			if (element) {
				element.remove();
				reindexItems();
			}
		}

		function reindexItems() {
			const items = document.querySelectorAll('#itemsContainer .subitem');

			items.forEach((item, index) => {
				const employeeInput = item.querySelector('input[name$=".EmployeeId"]');
				const startTimeInput = item.querySelector('input[name$=".StartTime"]');
				const endTimeInput = item.querySelector('input[name$=".EndTime"]');

				if (employeeInput) employeeInput.name = `Shifts[${index}].EmployeeId`;
				if (startTimeInput) startTimeInput.name = `Shifts[${index}].StartTime`;
				if (endTimeInput) endTimeInput.name = `Shifts[${index}].EndTime`;
			});
		}
	</script>
}
